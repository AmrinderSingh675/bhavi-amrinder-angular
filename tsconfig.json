{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",

    "rootDir": "./src",
    "outDir": "./dist/out-tsc",

    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",

    "strict": true,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@app/*": ["src/app/*"]
    }
  }
}